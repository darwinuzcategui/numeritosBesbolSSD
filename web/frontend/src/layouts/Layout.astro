---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Numeritos</title>
    <style is:global>
      :root {
        /* Paleta derivada de la hoja de Excel (amarillo / azul) */
        --yellow: #F6C600;          /* amarillo "nombre de equipo" */
        --yellow-strong: #E5B800;
        --yellow-paper: #FFFBE6;    /* amarillo claro (FFFFCC suavizado) */
        --blue: #1F4E8C;            /* azul profundo (derivado del azul claro) */
        --blue-soft: #E9EFF8;       /* azul claro de encabezados (D9E1F2) */
        --blue-pale: #CCCCFF;       /* azul pálido (Excel) */
        --navy: #141B2D;            /* barra superior (marcador) */
        --navy-2: #1C2540;

        --ink: #172033;
        --ink-2: #43506A;
        --ink-3: #8892A6;
        --line: rgba(23, 32, 51, 0.12);
        --line-soft: rgba(23, 32, 51, 0.07);
        --line-strong: rgba(23, 32, 51, 0.22);

        --surface: #FFFFFF;
        --surface-2: #F7F9FC;
        --canvas: #F4F6FA;

        --shadow-sm: 0 1px 2px rgba(23, 32, 51, 0.06);
        --shadow: 0 1px 2px rgba(23, 32, 51, 0.06), 0 6px 20px rgba(23, 32, 51, 0.07);

        --radius-s: 6px;
        --radius-m: 10px;
        --radius-l: 16px;

        --font: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
        --mono: "Cascadia Mono", Consolas, "SF Mono", ui-monospace, monospace;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: var(--font);
        font-size: 15px;
        line-height: 1.5;
        color: var(--ink);
        background: var(--canvas);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 1rem; }
      button {
        font-family: inherit; font-size: 0.9rem; font-weight: 600;
        padding: 0.5rem 1rem; border-radius: var(--radius-s);
        border: 1px solid transparent; cursor: pointer;
        background: var(--blue); color: #fff;
        transition: background 0.15s, transform 0.05s;
      }
      button:hover { background: #17406F; }
      button:active { transform: translateY(1px); }
      button:disabled { opacity: 0.5; cursor: not-allowed; }

      /* ---- Barra superior (marcador) ---- */
      .topbar {
        background: linear-gradient(180deg, var(--navy-2), var(--navy));
        color: #EAF0FA;
        border-bottom: 3px solid var(--yellow);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .topbar-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.7rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      .brand { display: flex; align-items: center; gap: 0.5rem; }
      .brand .diamond { color: var(--yellow); font-size: 1.1rem; line-height: 1; }
      .brand-name { font-weight: 700; font-size: 1.15rem; letter-spacing: 0.02em; color: #fff; }
      .league { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
      .league-title { font-weight: 600; font-size: 0.85rem; color: #fff; }
      .league-sub { font-size: 0.72rem; color: #A9B4C9; }
      .nav { display: flex; gap: 0.25rem; margin-left: auto; }
      .nav a {
        color: #CBD4E6;
        padding: 0.35rem 0.7rem;
        border-radius: var(--radius-s);
        font-weight: 500;
        font-size: 0.9rem;
        text-decoration: none;
      }
      .nav a:hover { color: #fff; background: rgba(255,255,255,0.08); text-decoration: none; }
      .nav a.active { color: #fff; background: rgba(246,198,0,0.16); box-shadow: inset 0 0 0 1px rgba(246,198,0,0.4); }
      .user { display: flex; align-items: center; gap: 0.6rem; }
      .user .name { font-weight: 600; font-size: 0.88rem; color: #fff; }
      .role-badge {
        font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em;
        padding: 0.1rem 0.5rem; border-radius: 999px;
        background: rgba(246,198,0,0.18); color: #FFE28A;
        text-transform: uppercase;
      }
      .btn-ghost {
        background: transparent; color: #CBD4E6; border: 1px solid rgba(255,255,255,0.25);
        padding: 0.3rem 0.65rem; border-radius: var(--radius-s); cursor: pointer; font-size: 0.82rem;
      }
      .btn-ghost:hover { background: rgba(255,255,255,0.1); color: #fff; }

      /* ---- Contenido ---- */
      .container { max-width: 1100px; margin: 1.5rem auto; padding: 0 1.25rem; }
      .page-head { margin-bottom: 1.25rem; }
      .page-head h1 { margin: 0 0 0.2rem; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; }
      .page-head .crumb { font-size: 0.85rem; color: var(--ink-3); }
      .page-head .crumb a { color: var(--blue); }

      .card {
        background: var(--surface);
        border: 1px solid var(--line-soft);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-sm);
        padding: 1.1rem 1.25rem;
        margin-bottom: 1.25rem;
      }
      .card h2 { margin: 0 0 0.8rem; font-size: 1.05rem; font-weight: 650; }

      /* ---- Tablas (libro de anotación) ---- */
      .table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius-m); box-shadow: var(--shadow-sm); }
      table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
      thead th {
        background: var(--blue-soft);
        color: var(--blue);
        font-weight: 650;
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        text-align: center;
        padding: 0.55rem 0.6rem;
        border-bottom: 2px solid var(--blue-pale);
        white-space: nowrap;
      }
      tbody td {
        padding: 0.5rem 0.6rem;
        border-top: 1px solid var(--line-soft);
        text-align: center;
        font-variant-numeric: tabular-nums;
      }
      tbody td:first-child, thead th:first-child { text-align: left; }
      tbody tr:nth-child(even) { background: var(--surface-2); }
      tbody tr:hover { background: var(--yellow-paper); }
      td.num, th.num { font-family: var(--mono); }

      /* ---- Formularios / controles ---- */
      input, select {
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.45rem 0.6rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-s);
        background: var(--surface);
        color: var(--ink);
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      input:focus, select:focus {
        outline: none;
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(31, 78, 140, 0.15);
      }
      input.small { width: 4rem; }
      label { display: block; font-size: 0.82rem; font-weight: 600; color: var(--ink-2); margin-bottom: 0.35rem; }

      button.btn, a.btn {
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-s);
        border: 1px solid transparent;
        cursor: pointer;
        background: var(--blue);
        color: #fff;
        transition: background 0.15s, transform 0.05s;
        text-decoration: none;
        display: inline-block;
      }
      button.btn:hover, a.btn:hover { background: #17406F; text-decoration: none; }
      button.btn:active { transform: translateY(1px); }
      button.btn-yellow { background: var(--yellow); color: var(--navy); }
      button.btn-yellow:hover { background: var(--yellow-strong); }
      button.btn-ghost-light { background: transparent; color: var(--blue); border: 1px solid var(--line-strong); }
      button.btn-ghost-light:hover { background: var(--blue-soft); }

      .error { color: #C0392B; font-size: 0.85rem; }
      .muted { color: var(--ink-3); }
      .ok { color: #1E7A46; font-weight: 600; }

      .field { margin-bottom: 0.9rem; }
      .inline-form { display: flex; gap: 0.5rem; align-items: flex-end; flex-wrap: wrap; }

      .auth-card { max-width: 380px; margin: 4rem auto; }
      .list-clean { list-style: none; padding: 0; margin: 0; }
      .list-clean li { padding: 0.55rem 0.35rem; border-bottom: 1px solid var(--line-soft); }
      .list-clean li:last-child { border-bottom: none; }
      .list-clean a { font-weight: 550; }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">
          <span class="diamond">◆</span>
          <span class="brand-name">Numeritos</span>
        </div>
        <div class="league">
          <span class="league-title" id="league-title">—</span>
          <span class="league-sub" id="league-sub">—</span>
        </div>
        <nav class="nav">
          <a href="/" data-nav="/">Equipos</a>
          <a href="/league/offense" data-nav="/league/offense">Total general</a>
          <a href="/league/pitching" data-nav="/league/pitching">Lanzadores</a>
          <a href="/league/standings" data-nav="/league/standings">Posiciones</a>
          <a href="/league/leaders" data-nav="/league/leaders">Líderes</a>
          <a href="/admin/users" data-nav="/admin/users" class="admin-only" style="display:none">Usuarios</a>
          <a href="/admin/settings" data-nav="/admin/settings" class="admin-only" style="display:none">Ajustes</a>
        </nav>
        <div class="user">
          <span class="name" id="nav-user"></span>
          <span class="role-badge" id="nav-role" style="display:none"></span>
          <button id="logout" class="btn-ghost" type="button">Salir</button>
        </div>
      </div>
    </header>

    <div class="container">
      <slot />
    </div>

    <script>
      import { me, api, logout } from '../lib/api.js';

      async function init() {
        // Info de la liga (independiente del login, para mostrarla también en el login)
        api('/settings').then((s) => {
          if (s.status === 200) {
            document.getElementById('league-title').textContent = `${s.data.division} · ${s.data.season}`;
            document.getElementById('league-sub').textContent = `${s.data.league} · ${s.data.category} · ${s.data.championship}`;
          }
        }).catch(() => {});

        const { status, data } = await me();
        if (status !== 200) {
          if (!location.pathname.startsWith('/login')) location.href = '/login';
          return;
        }
        const userEl = document.getElementById('nav-user');
        if (userEl) userEl.textContent = data.username;
        const roleEl = document.getElementById('nav-role');
        if (roleEl) { roleEl.textContent = data.role; roleEl.style.display = ''; }
        if (data.role === 'admin') {
          document.querySelectorAll('.admin-only').forEach((el) => { (el as HTMLElement).style.display = ''; });
        }

        // Marcar nav activo
        const path = location.pathname;
        document.querySelectorAll('.nav a').forEach((a) => {
          const el = a as HTMLAnchorElement;
          const target = el.dataset.nav || '';
          el.classList.toggle('active', target === '/' ? path === '/' : path.startsWith(target));
        });
      }

      const btn = document.getElementById('logout');
      if (btn) btn.addEventListener('click', async () => { await logout(); location.href = '/login'; });
      init();
    </script>
  </body>
</html>
