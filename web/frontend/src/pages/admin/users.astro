---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Usuarios">
  <div class="page-head"><h1>Usuarios</h1></div>
  <div class="card">
    <form id="new-user" class="inline-form">
      <input name="username" placeholder="Usuario" required />
      <input name="password" type="password" placeholder="Contraseña" required />
      <select name="role">
        <option value="capturador">capturador</option>
        <option value="admin">admin</option>
      </select>
      <button type="submit" class="btn btn-yellow">Agregar</button>
    </form>
    <p><span id="error" class="error"></span></p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Usuario</th><th>Rol</th><th></th></tr></thead>
      <tbody id="users"></tbody>
    </table>
  </div>
  <script>
    import { api } from '../../lib/api.js';

    async function load() {
      const { data } = await api('/users');
      const tbody = document.getElementById('users');
      tbody.innerHTML = '';
      for (const u of data) {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${u.username}</td><td>${u.role}</td>`;
        const td = document.createElement('td');
        const del = document.createElement('button');
        del.textContent = 'Eliminar';
        del.addEventListener('click', async () => {
          await api(`/users/${u.id}`, { method: 'DELETE' });
          load();
        });
        td.appendChild(del);
        tr.appendChild(td);
        tbody.appendChild(tr);
      }
    }

    document.getElementById('new-user').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const { status, data } = await api('/users', {
        method: 'POST',
        body: JSON.stringify({ username: fd.get('username'), password: fd.get('password'), role: fd.get('role') }),
      });
      if (status === 201) { (e.target as HTMLFormElement).reset(); load(); }
      else document.getElementById('error').textContent = data?.error || 'Error';
    });

    load();
  </script>
</Layout>
